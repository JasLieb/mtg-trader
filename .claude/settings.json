{
  "permissions": {
    "deny": [
      "Edit(/server/MtgTrader.Infrastructure/Migrations/**)",
      "Edit(/database/database.sql)",
      "Edit(/client/nginx/ssl/**)",
      "Edit(/server/ssl/**)",
      "Edit(/client/package-lock.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/quality-gate.js", "check"],
            "timeout": 600,
            "statusMessage": "Quality gate: build, lint, tests"
          }
        ]
      }
    ]
  }
}
